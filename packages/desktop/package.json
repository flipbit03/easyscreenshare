{
  "name": "@easyscreenshare/desktop",
  "productName": "easyscreenshare",
  "version": "0.0.0",
  "private": true,
  "description": "Tray-to-link screensharing",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "check": "tsc --noEmit",
    "make:win": "electron-forge package --platform=win32 --arch=x64 && electron-builder --prepackaged out/easyscreenshare-win32-x64 --win portable",
    "make:linux": "electron-forge package --platform=linux --arch=x64 && electron-builder --prepackaged out/easyscreenshare-linux-x64 --linux appimage"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.0",
    "@electron-forge/maker-zip": "^7.11.0",
    "@electron-forge/plugin-vite": "^7.11.0",
    "@electron-forge/shared-types": "^7.11.2",
    "@types/node": "^24.13.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@easyscreenshare/core": "workspace:*",
    "livekit-client": "^2.22.0"
  }
}
